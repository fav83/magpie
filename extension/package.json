{
  "name": "youtube-summarizer",
  "version": "1.0.0",
  "description": "AI-powered YouTube video summaries using OpenRouter",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:capture": "vite build --watch --mode development --config vite.capture.config.ts",
    "dev:worker": "vite build --watch --mode development --config vite.config.ts",
    "dev:content": "vite build --watch --mode development --config vite.content.config.ts",
    "dev:panel": "vite build --watch --mode development --config vite.sidepanel.config.ts",
    "dev:options": "vite build --watch --mode development --config vite.options.config.ts",
    "build": "npm-run-all build:clean build:copy build:worker build:content build:capture build:panel build:options",
    "build:clean": "rm -rf dist",
    "build:copy": "mkdir -p dist/icons && cp public/manifest.json dist/ && cp public/icons/* dist/icons/",
    "build:worker": "vite build --mode production --config vite.config.ts",
    "build:content": "vite build --mode production --config vite.content.config.ts",
    "build:capture": "vite build --mode production --config vite.capture.config.ts",
    "build:panel": "vite build --mode production --config vite.sidepanel.config.ts",
    "build:options": "vite build --mode production --config vite.options.config.ts",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
